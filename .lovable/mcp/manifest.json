          },
          "required": [
            "projectnr"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_employees",
        "title": "Medewerkers opvragen",
        "description": "Geef de medewerkers uit Maasmond planning terug, optioneel gefilterd op naam, functie of discipline.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "zoekterm": {
              "type": "string",
              "description": "Vrije tekst om medewerkers op te filteren."
