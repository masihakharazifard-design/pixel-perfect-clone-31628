              "description": "Vrije tekst om op te filteren."
            },
            "status": {
              "type": "string",
              "description": "Filter op status, bijvoorbeeld Gepland of Offerte."
            },
            "limiet": {
              "type": "integer",
              "description": "Maximaal aantal projecten (standaard 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Projectdetails opvragen",
        "description": "Geef alle opgeslagen gegevens van één project terug op basis van projectnummer of interne id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectnr": {
              "type": "string",
              "description": "Het projectnummer, werknummer of de interne id van het project."
